{
  "name": "wscats-blog",
  "version": "2.0.0",
  "description": "Waving wild hands in the wind, writing brilliant poems — A VitePress-powered tech blog",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint docs",
    "lint:fix": "eslint docs --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue,mts}": ["eslint --fix", "prettier --write"],
    "*.{js,mjs,cjs}": ["prettier --write"],
    "*.{json,md,yaml,yml}": ["prettier --write"]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^7.0.0",
    "vitepress": "^1.3.4",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
